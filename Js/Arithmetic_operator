// +,-,*, /

//Assignmnet operator

let a = 10;
let b = 5;

//Arithmetic Operator

let sum = a + b; // Addition
let sub= a - b; // Subtraction
let mul = a * b; // Multiplication
let div = a / b; // Division

console.log(sum);
console.log(sub);
console.log(mul);
console.log(div);

//Modulus operator - % - it will give the remainder of the division
let mod = a % b;

console.log(mod);

console.log(13%7);


//Exponential ** , power 2^3 = 8
let exp = 2 ** 3;
console.log(exp);

console.log(3**3);
